{
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] && exit 1 || exit 0",
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)opengraph-image",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/(.*)twitter-image",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/:path((?!index$|agents$)[a-z0-9-]+)\\.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://harvest.finance/:path>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://harvest.finance/>; rel=\"canonical\""
        }
      ]
    }
  ]
}
